import sympy as sp
import numpy as np
import matplotlib.pyplot as plt

# ==========================================
# 1. Задаём функцию
# ==========================================

x = sp.symbols('x')

g = x**3 + 2*x**2 - 5*x - 6

print("Функция:")
print("g(x) =", g)

# ==========================================
# 2. Факторизация
# ==========================================

g_factor = sp.factor(g)

print("\nФакторизация:")
print("g(x) =", g_factor)

# ==========================================
# 3. Точные корни
# ==========================================

roots = sp.solve(g, x)

print("\nТочные корни:")
for root in roots:
    print(root)

# ==========================================
# 4. Производная
# ==========================================

derivative = sp.diff(g, x)

print("\nПроизводная:")
print("g'(x) =", derivative)

# ==========================================
# 5. Интеграл
# ==========================================

integral = sp.integrate(g, x)

print("\nНеопределённый интеграл:")
print("∫g(x)dx =", integral)

# ==========================================
# 6. Преобразуем SymPy-функцию в NumPy
# ==========================================

g_num = sp.lambdify(x, g, 'numpy')

# ==========================================
# 7. Создаём сетку [-4; 4]
# ==========================================

x_values = np.linspace(-4, 4, 401)
y_values = g_num(x_values)

# ==========================================
# 8. Строим график
# ==========================================

plt.figure(figsize=(10, 6))

plt.plot(
    x_values,
    y_values,
    label='g(x) = x³ + 2x² − 5x − 6',
    linewidth=2
)

# Красные точки точных корней
roots_float = [float(root) for root in roots]

plt.scatter(
    roots_float,
    [0, 0, 0],
    color='red',
    s=70,
    zorder=5,
    label='Точные корни'
)

# Оси координат
plt.axhline(0, color='black', linewidth=0.8)
plt.axvline(0, color='black', linewidth=0.8)

# Подписи корней
for root in roots_float:
    plt.annotate(
        f'x = {root:g}',
        (root, 0),
        xytext=(0, 10),
        textcoords='offset points',
        ha='center'
    )

plt.grid(alpha=0.3)
plt.xlabel('x')
plt.ylabel('g(x)')
plt.title('График функции g(x) на [-4; 4]')
plt.legend()
plt.show()

# ==========================================
# 9. Проверка знаков функции
# ==========================================

print("\nПроверка знаков:")

test_points = [-4, -2, 0, 3]

for point in test_points:
    value = g.subs(x, point)
    print(f"g({point}) = {value}")

# ==========================================
# 10. Сравнение с сеткой из 21 точки
# ==========================================

x_values_21 = np.linspace(-4, 4, 21)
y_values_21 = g_num(x_values_21)

plt.figure(figsize=(10, 6))

plt.plot(
    x_values_21,
    y_values_21,
    marker='o',
    label='g(x), 21 точка'
)

plt.scatter(
    roots_float,
    [0, 0, 0],
    color='red',
    s=70,
    zorder=5,
    label='Точные корни'
)

plt.axhline(0, color='black', linewidth=0.8)
plt.axvline(0, color='black', linewidth=0.8)

plt.grid(alpha=0.3)
plt.xlabel('x')
plt.ylabel('g(x)')
plt.title('График функции при сетке из 21 точки')
plt.legend()
plt.show()

# ==========================================
# 11. Вывод
# ==========================================

print("\nВЫВОД:")
print(
    "Точный результат нужен, когда требуется получить математически "
    "строгое значение, например точные корни."
)
print(
    "Приближённого результата достаточно для численных расчётов "
    "и визуализации."
)
print(
    "Символьная переменная SymPy представляет математический объект, "
    "а обычная переменная Python обычно хранит конкретное значение."
)
print(
    "Преобразование выражения SymPy в функцию NumPy позволяет "
    "вычислять значения функции для массивов чисел."
)
print(
    "График помогает визуально проверить найденные корни и знаки функции."
)
print(
    "Чем плотнее сетка, тем плавнее и точнее выглядит график."
)
print(
    "Git сохраняет историю изменений и делает вычислительный эксперимент "
    "воспроизводимым."
)
