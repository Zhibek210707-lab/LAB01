from fractions import Fraction
from decimal import Decimal, getcontext

# float
float_result = 1 / 7 + 2 / 7
print("float:", float_result)

# Fraction
fraction_result = Fraction(1, 7) + Fraction(2, 7)
print("Fraction:", fraction_result)

# Decimal
getcontext().prec = 40
decimal_result = Decimal(1) / Decimal(7) + Decimal(2) / Decimal(7)
print("Decimal:", decimal_result)
import math

a = 0.1 + 0.2

print("a =", a)
print("a == 0.3:", a == 0.3)
print("math.isclose:", math.isclose(
    a, 0.3,
    rel_tol=1e-12,
    abs_tol=1e-12
))
import sympy as sp

x = sp.symbols('x')

g = x**4 - 5*x**2 + 4

print("Факторизация:", sp.factor(g))
print("Түбірлері:", sp.solve(sp.Eq(g, 0), x))
print("Бірінші туындысы:", sp.diff(g, x))
print("Анықталмаған интегралы:", sp.integrate(g, x))
exact_value = sp.simplify(g.subs(x, sp.sqrt(2)))
approx_value = sp.N(exact_value, 12)

print("Дәл мәні:", exact_value)
print("Жуық мәні:", approx_value)
