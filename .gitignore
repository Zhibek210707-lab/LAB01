     "text": [
      "float: 0.42857142857142855\n",
      "Fraction: 3/7\n",
      "Decimal: 0.428571428571428571428571428571\n"
     ]
    }
   ],
   "source": [
    "from fractions import Fraction\n",
    "from decimal import Decimal, getcontext\n",
    "\n",
    "print('float:', 1 / 7 + 2/7)\n",
    "print('Fraction:', Fraction(1, 7) + Fraction(2, 7))\n",
    "getcontext().prec = 30\n",
    "print('Decimal:', Decimal(1) / Decimal(7) + Decimal(2) / Decimal(7))"
   ]
  }
 ],
