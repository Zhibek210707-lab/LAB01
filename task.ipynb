import sympy as sp
import numpy as np
import matplotlib.pyplot as plt

# ============================================================
# ЭТАП 4. ЧИСЛЕННЫЙ ЭКСПЕРИМЕНТ И ГРАФИК
# ============================================================

# Символьная переменная
x = sp.symbols('x')

# Функция
g = x**3 + 2*x**2 - 5*x - 6

print("Функция:")
print("g(x) =", g)

# ============================================================
# 4.1. Преобразование символьной формулы в функцию NumPy
# ============================================================

g_num = sp.lambdify(x, g, 'numpy')

# Интервал [-4; 4]
x_values = np.linspace(-4, 4, 401)
y_values = g_num(x_values)

# Точные корни
roots = sp.solve(g, x)

print("\nТочные корни:")
print(roots)

# Перевод корней в числовой вид
real_roots = [float(root) for root in roots if root.is_real]

print("Числовые значения корней:")
print(real_roots)

# ============================================================
# Построение графика с точными корнями
# ============================================================

plt.figure(figsize=(8, 4.5))

plt.plot(
    x_values,
    y_values,
    label='g(x) = x³ + 2x² − 5x − 6'
)

plt.axhline(
    0,
    color='black',
    linewidth=0.8
)

plt.axvline(
    0,
    color='black',
    linewidth=0.8
)

# Красные точки корней
root_y = [float(g_num(r)) for r in real_roots]

plt.scatter(
    real_roots,
    root_y,
    color='red',
    s=70,
    zorder=5,
    label='Точные корни'
)

plt.grid(alpha=0.3)

plt.xlabel('x')
plt.ylabel('g(x)')

plt.title('График функции g(x) на [-4; 4]')

plt.legend()

plt.show()


# ============================================================
# 4.2. Интервалы положительности и отрицательности
# ============================================================

print("\n4.2. ЗНАК ФУНКЦИИ")

# Границы интервала и корни
points = [-4] + sorted(real_roots) + [4]

for i in range(len(points) - 1):

    left = points[i]
    right = points[i + 1]

    # Точка внутри интервала
    middle = (left + right) / 2

    value = float(g_num(middle))

    if value > 0:
        sign = "положительна"
    elif value < 0:
        sign = "отрицательна"
    else:
        sign = "равна нулю"

    print(
        f"Интервал ({left}; {right}): "
        f"x = {middle}, "
        f"g(x) = {value:.2f} → функция {sign}"
    )


# ============================================================
# Проверка подстановкой по одной точке из каждого интервала
# ============================================================

print("\nПРОВЕРКА ПОДСТАНОВКОЙ")

test_points = [-3.5, -2, 0, 3]

for point in test_points:

    result = g.subs(x, point)

    print(
        f"x = {point}: "
        f"g({point}) = {result}"
    )


# ============================================================
# 4.3. График с 21 точкой
# ============================================================

x_values_21 = np.linspace(-4, 4, 21)
y_values_21 = g_num(x_values_21)

plt.figure(figsize=(8, 4.5))

plt.plot(
    x_values_21,
    y_values_21,
    marker='o',
    label='g(x), 21 точка'
)

plt.axhline(
    0,
    color='black',
    linewidth=0.8
)

plt.axvline(
    0,
    color='black',
    linewidth=0.8
)

# Красные точки корней
plt.scatter(
    real_roots,
    [float(g_num(r)) for r in real_roots],
    color='red',
    s=70,
    zorder=5,
    label='Точные корни'
)

plt.grid(alpha=0.3)

plt.xlabel('x')
plt.ylabel('g(x)')

plt.title('График функции g(x) — 21 точка')

plt.legend()

plt.show()


# ============================================================
# СРАВНЕНИЕ ГРАФИКОВ
# ============================================================

print("\n4.3. СРАВНЕНИЕ")

print("""
При использовании 401 точки график получается плавным и
точнее отображает форму функции.

При использовании 21 точки график становится более грубым,
поскольку расстояние между соседними точками увеличивается.

Таким образом, чем плотнее сетка, тем точнее визуальное
представление функции. Редкая сетка может скрывать некоторые
особенности поведения функции.
""")


# ============================================================
# ЭТАП 5. ВЫВОД
# ============================================================

print("\nЭТАП 5. ВЫВОД")

